# Backend image used by api, worker, scheduler and the one-shot migrate job.
# The command is supplied per service in infra/compose.yaml.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Node.js + MJML CLI are required for server-side MJML rendering of templates.
# No build-essential: wheels cover the pinned Python deps, and compiling on
# the NVMe Docker root has dropped the disk under parallel Compose builds.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
        nodejs \
        npm \
    && npm install -g --no-audit --no-fund mjml@4 \
    && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /app

# Install Python dependencies first for better layer caching.
COPY pyproject.toml README.md ./
COPY services ./services
RUN pip install --no-cache-dir -e .

# Migration tooling and the app source.
COPY alembic.ini ./
COPY migrations ./migrations

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
