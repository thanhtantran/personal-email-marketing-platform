# Personal Email Marketing Platform - local configuration example.
# Copy to .env and fill in real values. NEVER commit a real .env or real secrets.
# Names and safe local placeholders only.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Web frontend (Next.js). NEXT_PUBLIC_* values are inlined into the browser
# bundle, so they must never hold secrets. Defaults in packages/api-client
# already match these values; set them only when they differ.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CSRF_COOKIE_NAME=csrf_token
NEXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://email:email@postgres:5432/email_platform

# ---------------------------------------------------------------------------
# Queue / cache (Redis + Celery)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; adobe/s3mock locally)
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_ACCESS_KEY=test
OBJECT_STORAGE_SECRET_KEY=test
OBJECT_STORAGE_BUCKET=email-platform
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_TLS=false

# ---------------------------------------------------------------------------
# Google OAuth / OIDC (owner-only Phase 1)
# Prefer OWNER_GOOGLE_SUB (stable subject) over email.
# ---------------------------------------------------------------------------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
OWNER_GOOGLE_SUB=
OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Sessions / CSRF
# SESSION_COOKIE_SECURE: leave empty to auto-derive from APP_BASE_URL scheme.
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECURE=
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_HOURS=12
OAUTH_STATE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Workspace bootstrap
# ---------------------------------------------------------------------------
TENANT_SLUG=personal
TENANT_NAME=Personal Workspace

# ---------------------------------------------------------------------------
# Secrets / crypto
# SESSION_KEY: >= 32 bytes. ENCRYPTION_KEY_REF points to a mounted secret file
# in local dev; production must use an external KMS/secret manager reference.
# ---------------------------------------------------------------------------
SESSION_KEY=dev-only-change-me-please-32-bytes-min
ENCRYPTION_KEY_REF=file://./secrets/dev-encryption-key
ENCRYPTION_KEY_VERSION=1

# ---------------------------------------------------------------------------
# Sending / provider
# The provider gateway treats an account's marketing eligibility and its
# capacity snapshot as dated facts: routing excludes an account whose facts are
# older than these windows, and a send that cannot route is deferred (never
# dropped) for PROVIDER_ROUTING_DEFER_SECONDS before it is retried.
# ---------------------------------------------------------------------------
PROVIDER_DEFAULT=resend
PROVIDER_ELIGIBILITY_TTL_SECONDS=604800
PROVIDER_CAPACITY_TTL_SECONDS=86400
PROVIDER_ROUTING_DEFER_SECONDS=900
TRACKING_ENABLED=false

# ---------------------------------------------------------------------------
# Content / templates
# MJML_BINARY: CLI used for server-side template rendering (installed in the
# API image). TEST_SEND_ALLOWLIST: comma-separated addresses permitted to
# receive test sends; the configured OWNER_EMAIL is always allowed.
# PREVIEW_ORIGIN: optional isolated origin used to render previews in a browser.
# ---------------------------------------------------------------------------
MJML_BINARY=mjml
MJML_TIMEOUT_SECONDS=20
TEMPLATE_MAX_SOURCE_BYTES=512000
PREVIEW_ORIGIN=
TEST_SEND_ALLOWLIST=

# ---------------------------------------------------------------------------
# Provisional deployment limits (operator-tunable; NOT product guarantees)
# ---------------------------------------------------------------------------
IMPORT_MAX_FILE_MB=50
IMPORT_MAX_ROWS=200000
IMPORT_MAX_COLUMNS=100
IMPORT_MAX_FIELD_LENGTH=4096
CAMPAIGN_BATCH_SIZE=500
SEND_REQUEST_TIMEOUT_SECONDS=30
SEND_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Campaign scheduler / transactional outbox
# A single-active scheduler holds a PostgreSQL advisory lock; the outbox bridges
# the DB-commit/queue-publish gap with at-least-once delivery.
# ---------------------------------------------------------------------------
CAMPAIGN_SCHEDULER_INTERVAL_SECONDS=30
CAMPAIGN_DUE_BATCH_SIZE=50
CAMPAIGN_OUTBOX_BATCH_SIZE=100
CAMPAIGN_OUTBOX_MAX_ATTEMPTS=5
SCHEDULER_ADVISORY_LOCK_KEY=4217090183

# ---------------------------------------------------------------------------
# Retention / policy
# RETENTION_INTERVAL_SECONDS: cadence of the retention jobs, run by the
# single-active scheduler. Each run is bounded and idempotent.
# ---------------------------------------------------------------------------
RAW_WEBHOOK_RETENTION_DAYS=14
STAGED_UPLOAD_RETENTION_DAYS=7
IMPORT_ROW_RETENTION_DAYS=90
RETENTION_INTERVAL_SECONDS=86400

# ---------------------------------------------------------------------------
# Observability
# /metrics is a private-network endpoint. Set METRICS_ENABLED=false to remove
# it, or set METRICS_TOKEN to require `Authorization: Bearer <token>`.
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_TOKEN=
